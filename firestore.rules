rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saloes/{salonId} {

      // Config: qualquer um lê (necessário para a página de agendamento)
      // Só o dono autenticado escreve
      match /config/{doc} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == salonId;
      }

      // Agendamentos: qualquer um lê/cria (clientes verificam horários e agendam)
      // Só o dono atualiza/exclui (concluir, cancelar, excluir)
      match /agendamentos/{id} {
        allow read, create: if true;
        allow update, delete: if request.auth != null && request.auth.uid == salonId;
      }
    }
  }
}
